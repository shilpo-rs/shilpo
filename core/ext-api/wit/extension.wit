package shilpo:extension@0.1.0;

/// Shared data structures, identity shapes, envelopes, errors, and deadlines across the extension ABI boundary.
interface types {
    /// Opaque string identifier for an extension (e.g., "org.shilpo.weather").
    record extension-id {
        value: string,
    }

    /// Opaque string identifier for a single contribution within an extension (e.g., "bar_widget").
    record contribution-id {
        value: string,
    }

    /// Canonical combined identity ("extension_id/contribution_id").
    record canonical-id {
        extension-id: string,
        contribution-id: string,
    }

    /// Request correlation identifier for asynchronous host import operations.
    type request-id = string;

    /// Monotonic activation correlation identifier.
    type activation-id = string;

    /// Monotonic deadline represented as remaining milliseconds.
    record deadline {
        remaining-ms: u64,
    }

    /// Classification of typed errors returned by host imports.
    enum error-kind {
        unauthorized,
        invalid-argument,
        not-found,
        rate-limited,
        unsupported,
        internal,
        backend-unavailable,
        locked,
        denied,
        cancelled,
    }

    /// Standard error payload returned by host imports.
    record error {
        kind: error-kind,
        message: string,
    }

    /// Opaque reference handle to an encrypted secret stored in host secret service.
    record secret-ref {
        handle: string,
    }

    /// Typed scalar data value used for extension settings, input, state, and
    /// action payloads. It is not a JSON string at the component boundary.
    variant data-value {
        none,
        bool-value(bool),
        int-value(s64),
        float-value(f64),
        text-value(string),
        bytes-value(list<u8>),
        secret-ref(secret-ref),
    }

    record activation-input {
        contribution-id: option<string>,
        event-id: option<string>,
        value: option<data-value>,
    }

    record caller {
        id: string,
        kind: string,
    }

    /// Explicit trigger origin for component activation.
    variant activation-origin {
        shell-startup,
        contribution-mount,
        user-input,
        event-dispatch,
        system-resume,
    }

    /// Enclosing context provided during component activation/start.
    record activation {
        id: activation-id,
        origin: activation-origin,
        extension-id: string,
        contribution-id: option<string>,
        input: option<activation-input>,
        caller: option<caller>,
        deadline: option<deadline>,
    }

    /// Reason for orderly guest component deactivation.
    enum deactivate-reason {
        user-requested,
        shell-shutdown,
        reload,
        error-quarantine,
    }

    /// Scope classification of search modes supported by search providers.
    enum search-mode {
        default,
        apps,
        actions,
        clipboard,
        calculator,
        command,
        web-search,
        keybindings,
    }

    /// Classification of candidate search results.
    enum search-result-category {
        window,
        application,
        action,
        clipboard,
        calculator,
        command,
        web-search,
        file-path,
        uri,
        keybinding,
        custom,
    }

    /// Icon descriptor for search candidate presentation.
    variant search-icon {
        none,
        named(string),
        asset(string),
    }

    /// Inbound query request passed to an extension search provider.
    record search-request {
        raw-query: string,
        query: string,
        mode: search-mode,
        generation: u64,
    }

    /// Search candidate emitted by an extension search provider.
    record search-candidate {
        id: string,
        title: string,
        subtitle: option<string>,
        aliases: list<string>,
        keywords: list<string>,
        category: search-result-category,
        icon: option<search-icon>,
        activation-verb: string,
        activation-payload: string,
    }
}

/// Host import for wallpaper reading and setting.
/// Required capability scopes: `wallpaper:read`, `wallpaper:set`.
interface wallpaper {
    use types.{error, request-id};

    enum wallpaper-mode {
        manual,
        slideshow,
    }

    enum wallpaper-target-kind {
        global,
        workspace,
    }

    enum wallpaper-request-reason {
        activate,
        user-next,
        slideshow-tick,
        workspace-changed,
        settings-changed,
    }

    record workspace-target {
        workspace-id: string,
        output-name: option<string>,
    }

    variant wallpaper-target {
        global,
        workspace(workspace-target),
    }

    record wallpaper-request {
        request-id: request-id,
        contribution-id: string,
        reason: wallpaper-request-reason,
        mode: wallpaper-mode,
        target: wallpaper-target,
    }

    enum wallpaper-source {
        extension-asset,
        local-file,
        remote,
    }

    record wallpaper-info {
        path: string,
    }

    record wallpaper-set-request {
        request-id: option<request-id>,
        path: string,
        source: wallpaper-source,
        target: option<wallpaper-target>,
    }

    /// Sets system wallpaper path and source.
    set: func(req: wallpaper-set-request) -> result<_, error>;

    /// Reads current system wallpaper info.
    read: func() -> result<wallpaper-info, error>;
}

/// Inbound lifecycle, environment, and contribution interaction events dispatched to guest extensions.
interface events {
    use types.{canonical-id, request-id, data-value};
    use wallpaper.{wallpaper-request, wallpaper-target};

    /// High-level event category names for capability filtering.
    enum event-kind {
        outputs-changed,
        theme-changed,
        palette-generated,
        wallpaper-changed,
        network-changed,
        media-changed,
        power-changed,
        timer-fired,
        workspace-changed,
    }

    enum bar-menu-close-reason {
        source-toggle,
        escape,
        focus-lost,
        outside-click,
        overview-opened,
        bar-closed,
        display-removed,
        owner-removed,
        source-unavailable,
    }

    /// Inbound events dispatched into guest components.
    variant extension-event {
        shell-started,
        shell-stopping,
        outputs-changed,
        theme-changed(theme-event),
        palette-generated(palette-event),
        wallpaper-changed(wallpaper-event),
        network-changed(network-event),
        media-changed(media-event),
        power-changed(power-event),
        timer-fired(timer-event),
        workspace-changed(workspace-event),
        wallpaper-request(wallpaper-request),
        wallpaper-result(wallpaper-result-event),
        contribution-mounted(mounted-event),
        contribution-unmounted(unmounted-event),
        contribution-resized(resized-event),
        contribution-settings-changed(settings-event),
        bar-menu-opened(bar-menu-opened-payload),
        bar-menu-closed(bar-menu-closed-payload),
        input(input-event),
        state-value(state-event),
        http-response(http-response-event),
        location-response(location-response-event),
    }

    record theme-event { mode: string }
    record palette-event { accent: string }
    record wallpaper-event { path: string }
    record network-event { connected: bool }
    record media-event { title: option<string>, artist: option<string>, playing: bool }
    record power-event { percentage: option<f32>, charging: bool }
    record timer-event { name: string }
    record workspace-event { workspace-id: string, workspace-name: option<string>, output-name: option<string> }
    record wallpaper-result-event { request-id: request-id, success: bool, error: option<string> }
    record mounted-event { contribution-id: string, instance-id: option<string>, width: f32, height: f32 }
    record unmounted-event { contribution-id: string, instance-id: option<string> }
    record resized-event { contribution-id: string, instance-id: option<string>, width: f32, height: f32 }
    record settings-event { contribution-id: string, instance-id: option<string>, settings: data-value }
    record bar-menu-opened-payload { contribution-id: string, instance-id: string }
    record bar-menu-closed-payload { contribution-id: string, instance-id: string, reason: bar-menu-close-reason }
    record input-event { contribution-id: string, instance-id: option<string>, event-id: string, value: option<data-value> }
    /// State-change event queued for a live watch after a changed mutation commits.
    /// `value` is `none` for deletions. Events for one watch preserve revision order.
    record state-event { watch-id: u64, key: string, value: option<data-value>, revision: u64 }
    record http-response-event { request-id: string, status: option<u16>, body: string, error: option<string> }
    record location-response-event { latitude: option<f64>, longitude: option<f64>, accuracy-meters: option<f64>, error: option<string> }
}

/// Declarative ViewTree UI component family produced by extensions for rendering.
interface view {
    variant container-direction {
        row,
        column,
        stack,
        grid(u16),
    }

    enum alignment {
        start,
        center,
        end,
        stretch,
    }

    enum justification {
        start,
        center,
        end,
        space-between,
        space-around,
    }

    enum overflow {
        visible,
        hidden,
        scroll,
    }

    enum text-align {
        start,
        center,
        end,
    }

    record edge-insets {
        top: option<f32>,
        right: option<f32>,
        bottom: option<f32>,
        left: option<f32>,
    }

    record corner-radii {
        top-left: option<f32>,
        top-right: option<f32>,
        bottom-left: option<f32>,
        bottom-right: option<f32>,
    }

    enum semantic-color-token {
        surface,
        on-surface,
        surface-dim,
        surface-bright,
        surface-container-lowest,
        surface-container-low,
        surface-container,
        surface-container-high,
        surface-container-highest,
        surface-variant,
        on-surface-variant,
        inverse-surface,
        inverse-on-surface,
        outline,
        outline-variant,
        shadow,
        scrim,
        surface-tint,
        primary,
        on-primary,
        primary-container,
        on-primary-container,
        inverse-primary,
        primary-fixed,
        primary-fixed-dim,
        on-primary-fixed,
        on-primary-fixed-variant,
        secondary,
        on-secondary,
        secondary-container,
        on-secondary-container,
        secondary-fixed,
        secondary-fixed-dim,
        on-secondary-fixed,
        on-secondary-fixed-variant,
        tertiary,
        on-tertiary,
        tertiary-container,
        on-tertiary-container,
        tertiary-fixed,
        tertiary-fixed-dim,
        on-tertiary-fixed,
        on-tertiary-fixed-variant,
        error,
        on-error,
        error-container,
        on-error-container,
    }

    record linear-gradient {
        angle: f32,
        start-color: semantic-color-token,
        end-color: semantic-color-token,
    }

    variant fill {
        solid(semantic-color-token),
        linear-gradient(linear-gradient),
    }

    record shadow-style {
        color: semantic-color-token,
        offset-x: f32,
        offset-y: f32,
        blur-radius: f32,
        spread-radius: f32,
        inset: bool,
    }

    record view-style {
        padding: option<f32>,
        padding-edges: option<edge-insets>,
        margin: option<f32>,
        margin-edges: option<edge-insets>,
        width: option<f32>,
        height: option<f32>,
        corner-radius: option<f32>,
        corner-radii: option<corner-radii>,
        opacity: option<f32>,
        color: option<semantic-color-token>,
        background: option<fill>,
        flex-grow: option<f32>,
        border-width: option<f32>,
        border-edges: option<edge-insets>,
        border-color: option<semantic-color-token>,
        shadows: option<list<shadow-style>>,
        min-width: option<f32>,
        max-width: option<f32>,
        min-height: option<f32>,
        max-height: option<f32>,
        overflow: option<overflow>,
    }

    variant view-node {
        container(container-node),
        text(text-node),
        icon(icon-node),
        image(image-node),
        button(button-node),
        icon-button(icon-button-node),
        toggle(toggle-node),
        slider(slider-node),
        text-input(text-input-node),
        %list(list-node),
        spacer(spacer-node),
        divider,
        badge(badge-node),
        progress(progress-node),
        loading-indicator(loading-indicator-node),
    }

    record container-node {
        direction: container-direction,
        children: list<u32>,
        style: option<view-style>,
        gap: option<f32>,
        align-items: option<alignment>,
        justify-content: option<justification>,
        wrap: bool,
        event-id: option<string>,
    }

    record text-node {
        content: string,
        font-size: option<f32>,
        bold: option<bool>,
        italic: option<bool>,
        text-align: option<text-align>,
        line-height: option<f32>,
        letter-spacing: option<f32>,
        max-lines: option<u32>,
        style: option<view-style>,
    }

    record icon-node {
        name: string,
        size: option<f32>,
        style: option<view-style>,
    }

    record image-node {
        asset-path: string,
        width: option<f32>,
        height: option<f32>,
        style: option<view-style>,
    }

    record button-node {
        label: string,
        event-id: string,
        style: option<view-style>,
    }

    record icon-button-node {
        icon-name: string,
        event-id: string,
        style: option<view-style>,
    }

    record toggle-node {
        value: bool,
        event-id: string,
        style: option<view-style>,
    }

    record slider-node {
        value: f32,
        min: f32,
        max: f32,
        event-id: string,
        style: option<view-style>,
    }

    record text-input-node {
        placeholder: option<string>,
        value: string,
        event-id: string,
        style: option<view-style>,
    }

    record list-node {
        items: list<u32>,
        style: option<view-style>,
    }

    record spacer-node {
        size: option<f32>,
    }

    record badge-node {
        label: string,
        style: option<view-style>,
    }

    record progress-node {
        value: f32,
        style: option<view-style>,
    }

    record loading-indicator-node {
        size: option<f32>,
        color: option<semantic-color-token>,
        style: option<view-style>,
    }

    record view-tree {
        nodes: list<view-node>,
        root: u32,
    }
}

/// Host import for invoking registered system actions.
/// Required capability scope: `actions:invoke`.
interface actions {
    use types.{error, data-value};

    /// Invokes a desktop shell action with optional payload.
    invoke: func(action-id: string, payload: option<data-value>) -> result<_, error>;
}

/// Host import for system clipboard access.
/// Required capability scopes: `clipboard:read`, `clipboard:write`.
interface clipboard {
    use types.{error};

    /// Reads current plain text from system clipboard.
    read: func() -> result<string, error>;

    /// Writes plain text to system clipboard.
    write: func(text: string) -> result<_, error>;
}

/// Host import for virtual path filesystem access (`assets/`, `data/`, `user/`).
/// Required capability scopes: `filesystem:read`, `filesystem:write`.
interface filesystem {
    use types.{error};

    /// Reads binary content from a virtual file path.
    read-file: func(path: string) -> result<list<u8>, error>;

    /// Writes binary content to a virtual file path.
    write-file: func(path: string, contents: list<u8>) -> result<_, error>;
}

/// Host import for outbound HTTPS network requests.
/// Required capability scope: `network:http`.
interface http {
    use types.{request-id, deadline, error};

    /// Network request description.
    record http-request {
        request-id: request-id,
        url: string,
        method: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
        deadline: option<deadline>,
    }

    /// Enqueues an asynchronous HTTP request; response delivered via `events.http-response`.
    request: func(req: http-request) -> result<request-id, error>;

    /// Cancels an in-flight HTTP request by ID.
    cancel: func(req-id: request-id) -> result<_, error>;
}

/// Host import for geolocation reading.
/// Required capability scope: `location:read`.
interface location {
    use types.{request-id, error};

    /// Requests current device location; result delivered via `events.location-response`.
    read: func() -> result<request-id, error>;
}

/// Host import for desktop notification display.
/// Required capability scope: `notifications:show`.
interface notifications {
    use types.{error};

    record notification-request {
        title: string,
        body: string,
        icon: option<string>,
    }

    /// Displays a desktop notification.
    show: func(req: notification-request) -> result<_, error>;
}

/// Host import for extension-scoped key-value state.
///
/// State is namespaced by the validated extension ID and a UTF-8 key, persisted in a
/// durable per-extension store with a monotonic revision. Keys must be non-empty and
/// at most 256 UTF-8 bytes; each extension is bounded to 256 keys and 4 MiB of
/// encoded data, with each encoded value at most 64 KiB. State requires no manifest
/// capability because an extension can access only its own bounded namespace.
///
/// `watch` atomically registers a watch and returns the current snapshot, closing
/// the read-then-watch race. Watch IDs are runtime-local opaque IDs and do not
/// persist across unload/restart. Changed mutations queue one `events.state-value`
/// event per matching live watch, delivered after the initiating host call returns.
interface state {
    use types.{error, data-value};

    /// Value and durable per-extension revision at read/watch time.
    record state-snapshot {
        value: option<data-value>,
        revision: u64,
    }

    /// Outcome of a state mutation.
    record state-mutation {
        changed: bool,
        revision: u64,
    }

    /// Watch registration with the atomic snapshot taken at registration time.
    record watch-registration {
        watch-id: u64,
        snapshot: state-snapshot,
    }

    /// Reads the stored value and current revision for `key`. A missing key yields
    /// `state-snapshot { value: none, revision: current-extension-revision }`.
    read: func(key: string) -> result<state-snapshot, error>;

    /// Writes `value` for `key`. A byte-for-byte equivalent value is an idempotent
    /// no-op (`changed = false`, revision unchanged). `secret-ref` values are
    /// rejected with `invalid-argument`.
    write: func(key: string, value: data-value) -> result<state-mutation, error>;

    /// Deletes `key`. Deleting a missing key is an idempotent no-op.
    delete: func(key: string) -> result<state-mutation, error>;

    /// Atomically registers a watch on `key` and returns the current snapshot.
    watch: func(key: string) -> result<watch-registration, error>;

    /// Removes a watch registration by runtime-local ID (idempotent).
    unwatch: func(watch-id: u64) -> result<_, error>;
}

/// Host import for encrypted secret storage backed by Secret Service.
/// Required capability scopes: `secrets:<purpose>`.
interface secrets {
    use types.{secret-ref, error};

    /// Creates or replaces a secret for the specified purpose.
    set: func(purpose: string, value: list<u8>) -> result<secret-ref, error>;

    /// Reads secret value for purpose and opaque reference.
    read: func(purpose: string, reference: secret-ref) -> result<option<list<u8>>, error>;

    /// Deletes secret entry for purpose and opaque reference (idempotent).
    delete: func(purpose: string, reference: secret-ref) -> result<_, error>;
}

/// Host import for system theme inspection and accent setting.
/// Required capability scopes: `theme:read`, `theme:set_source`.
interface theme {
    use types.{error};

    record theme-info {
        mode: string,
        accent: string,
    }

    /// Reads current desktop theme state.
    read: func() -> result<theme-info, error>;

    /// Sets custom accent seed color hex.
    set-source-color: func(color: string) -> result<_, error>;
}



/// Canonical Shilpo extension component world.
world extension {
    use types.{activation, deactivate-reason, error, search-candidate, search-request};
    use events.{extension-event};
    use view.{view-tree};

    import actions;
    import clipboard;
    import filesystem;
    import http;
    import location;
    import notifications;
    import state;
    import secrets;
    import theme;
    import wallpaper;

    export activate: func(act: activation) -> result<_, error>;
    export deactivate: func(reason: deactivate-reason) -> result<_, error>;
    export on-event: func(event: extension-event) -> result<_, error>;
    export view: func(contribution-id: string) -> result<option<view-tree>, error>;
    export search: func(contribution-id: string, request: search-request) -> result<list<search-candidate>, error>;
}
